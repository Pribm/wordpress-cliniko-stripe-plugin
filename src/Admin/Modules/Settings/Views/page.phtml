<?php
/** @var string $currentTab */
/** @var array<string,string> $tabs */
?>
<div class="cliniko-admin-page cliniko-settings-page">
    <nav class="nav-tab-wrapper es-settings-tabs cliniko-admin-subnav" aria-label="Settings sections">
        <?php foreach ($tabs as $tab => $label) : ?>
            <a href="<?php echo esc_url(add_query_arg(['page' => 'wp-cliniko-stripe-settings', 'tab' => $tab], admin_url('admin.php'))); ?>" class="nav-tab<?php echo $currentTab === $tab ? ' nav-tab-active' : ''; ?>"<?php echo $currentTab === $tab ? ' aria-current="page"' : ''; ?> data-es-settings-tab="<?php echo esc_attr($tab); ?>"><?php echo esc_html($label); ?></a>
        <?php endforeach; ?>
    </nav>

    <form method="post" action="options.php" class="cliniko-settings-form">
        <?php settings_fields('wp_cliniko_stripe_group'); ?>
        <?php do_settings_sections('wp-cliniko-stripe-settings'); ?>
        <?php submit_button('Save Settings'); ?>
    </form>
</div>
<script>
    (function () {
        const initialTab = <?php echo wp_json_encode($currentTab); ?>;
        const root = document.querySelector('.cliniko-settings-page');
        const tabs = root.querySelectorAll('[data-es-settings-tab]');
        const tables = root.querySelectorAll('.cliniko-settings-form .form-table');
        const groups = [];

        tables.forEach(function (table) {
            let group = 'credentials';
            if (table.querySelector('[name^="wp_cliniko_patient_"]')) group = 'patient-accounts';
            const sectionNodes = [];
            let node = table.previousElementSibling;
            while (node) {
                sectionNodes.unshift(node);
                if (node.tagName === 'H2') break;
                node = node.previousElementSibling;
            }
            sectionNodes.push(table);
            groups.push({ group: group, nodes: sectionNodes });
        });

        function showTab(tab) {
            groups.forEach(function (item) {
                item.nodes.forEach(function (node) { node.classList.toggle('es-settings-tab-hidden', item.group !== tab); });
            });
            tabs.forEach(function (link) {
                const active = link.dataset.esSettingsTab === tab;
                link.classList.toggle('nav-tab-active', active);
                if (active) link.setAttribute('aria-current', 'page');
                else link.removeAttribute('aria-current');
            });
        }

        tabs.forEach(function (link) {
            link.addEventListener('click', function (event) {
                event.preventDefault();
                showTab(link.dataset.esSettingsTab);
                window.history.replaceState({}, '', link.href);
            });
        });
        showTab(initialTab);
    }());
</script>
