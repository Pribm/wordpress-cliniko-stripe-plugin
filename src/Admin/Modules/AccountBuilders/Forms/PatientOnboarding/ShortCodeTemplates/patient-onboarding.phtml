                        $maskSuffix = $inputFormat === 'pattern' ? (string) ($fieldConfig['mask_suffix'] ?? '') : '';
                        $maskHint = $inputFormat === 'pattern' && $maskPattern !== '' ? $maskExample($maskPattern, $maskPrefix, $maskSuffix) : '';
                        $inputAttributes = $maxLength > 0 ? ' maxlength="' . esc_attr((string) $maxLength) . '" data-onboarding-max-length="' . esc_attr((string) $maxLength) . '"' : '';
                        if ($inputFormat === 'numbers') {
