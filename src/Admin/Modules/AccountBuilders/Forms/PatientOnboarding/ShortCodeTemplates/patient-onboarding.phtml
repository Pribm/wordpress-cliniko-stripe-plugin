$hasWelcome = !empty($module['welcome_enabled']) && $messageState === '' && trim($welcomeContent) !== '';
$stepCount = count($steps);
$configuredPlacement = in_array((string) ($module['placement'] ?? 'inline'), ['inline', 'modal', 'blocking_overlay'], true)
