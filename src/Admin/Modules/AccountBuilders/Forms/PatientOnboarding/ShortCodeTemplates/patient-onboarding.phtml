                        }
                        $isChoices = in_array($clinikoFieldType, ['radiobuttons', 'radio', 'checkboxes', 'multi_checkbox'], true);
                        $inputFormat = in_array((string) ($fieldConfig['input_format'] ?? 'none'), ['numbers', 'pattern'], true) ? (string) $fieldConfig['input_format'] : 'none';
                        $maxLength = max(0, min(5000, (int) ($fieldConfig['max_length'] ?? 0)));
