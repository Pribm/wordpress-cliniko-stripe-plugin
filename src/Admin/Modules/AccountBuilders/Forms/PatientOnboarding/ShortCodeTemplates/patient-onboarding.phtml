/** @var array<string,bool> $switchValues */
/** @var array<int,array{key:string,label:string}> $missing */
/** @var string $messageState */
/** @var string $patientSaveAction */
/** @var string $returnTo */
/** @var string $welcomeContent */
/** @var string $instanceId */
$title = (string) ($module['title'] ?? 'Complete your profile');
$subtitle = (string) ($module['subtitle'] ?? 'Please complete the required details before continuing.');
