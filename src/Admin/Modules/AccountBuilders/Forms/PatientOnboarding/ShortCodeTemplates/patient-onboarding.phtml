$isOverlay = in_array($placement, ['modal', 'blocking_overlay'], true);
$titleId = 'cliniko-onboarding-title-' . sanitize_html_class($id);
$styleVariables = [];
$styleMap = [
    'primary_color' => '--cliniko-onboarding-primary',
    'title_color' => '--cliniko-onboarding-title',
    'label_color' => '--cliniko-onboarding-label',
    'text_color' => '--cliniko-onboarding-text',
    'surface_color' => '--cliniko-onboarding-surface',
    'border_color' => '--cliniko-onboarding-border',
];
if (!empty($module['colors_enabled'])) {
    foreach ($styleMap as $setting => $variable) {
        $color = sanitize_hex_color((string) ($module[$setting] ?? ''));
        if ($color !== '') {
            $styleVariables[] = $variable . ':' . $color;
        }
    }
}
$fontFamily = (string) ($module['font_family'] ?? '');
if ($fontFamily !== '') {
    $styleVariables[] = '--cliniko-onboarding-font-family:' . esc_attr($fontFamily);
    $styleVariables[] = '--cliniko-onboarding-heading-family:' . esc_attr($fontFamily);
}
foreach (['heading_font_size' => '--cliniko-onboarding-heading-size', 'body_font_size' => '--cliniko-onboarding-body-size'] as $setting => $variable) {
    $size = (int) ($module[$setting] ?? 0);
    if ($size > 0) {
        $styleVariables[] = $variable . ':' . $size . 'px';
    }
}
$styleAttribute = $styleVariables !== [] ? ' style="' . esc_attr(implode(';', $styleVariables)) . '"' : '';
$truthy = static fn($value): bool => $value === true || $value === 1 || in_array(strtolower((string) $value), ['1', 'yes', 'true', 'on'], true);
$optionValue = static fn($option): string => is_array($option)
    ? (string) ($option['value'] ?? $option['name'] ?? $option['label'] ?? '')
    : (string) $option;
$selectedValues = static function ($value): array {
    if (is_array($value)) {
        return array_values(array_filter(array_map('strval', $value), static fn(string $item): bool => $item !== ''));
    }
    return array_values(array_filter(array_map('trim', explode(',', (string) $value)), static fn(string $item): bool => $item !== ''));
};
$maskExample = static function (string $pattern, string $prefix, string $suffix): string {
    $digit = 1;
    $letter = 0;
    $letters = 'ABCDEFGHJKLMNPQRSTUVWXYZ';
    $characters = preg_split('//u', $pattern, -1, PREG_SPLIT_NO_EMPTY);
    if (!is_array($characters)) {
        $characters = str_split($pattern);
    }
    $body = '';
    foreach ($characters as $character) {
        if ($character === '#') {
            $body .= (string) $digit;
            $digit = $digit === 9 ? 1 : $digit + 1;
        } elseif ($character === 'A') {
            $body .= $letters[$letter % strlen($letters)];
            $letter++;
        } elseif ($character === '*') {
            $body .= $letter % 2 === 0 ? $letters[$letter % strlen($letters)] : (string) $digit;
            $letter++;
            $digit = $digit === 9 ? 1 : $digit + 1;
        } else {
            $body .= $character;
        }
    }
    return $prefix . $body . $suffix;
};
$isoDateValue = static function ($value): string {
    if (!is_scalar($value) || trim((string) $value) === '') {
        return '';
    }
    $value = substr(trim((string) $value), 0, 10);
    $date = \DateTimeImmutable::createFromFormat('!Y-m-d', $value);
    $errors = \DateTimeImmutable::getLastErrors();
    if (!$date instanceof \DateTimeImmutable
        || (is_array($errors) && ((int) $errors['warning_count'] > 0 || (int) $errors['error_count'] > 0))
        || $date->format('Y-m-d') !== $value) {
        return '';
    }
    return $date->format('Y-m-d');
};
$displayDate = static function ($value, string $format) use ($isoDateValue): string {
    $isoDate = $isoDateValue($value);
    if ($isoDate === '') {
        return is_scalar($value) ? (string) $value : '';
    }
    $date = \DateTimeImmutable::createFromFormat('!Y-m-d', $isoDate);
    $formats = [
        'dmy_slash' => 'd/m/Y',
        'mdy_slash' => 'm/d/Y',
        'ymd_dash' => 'Y-m-d',
        'dmy_dash' => 'd-m-Y',
    ];
    return $date instanceof \DateTimeImmutable ? $date->format($formats[$format] ?? $formats['dmy_slash']) : '';
};
